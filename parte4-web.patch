+    })
+  }
+
+  function placeTorches(r) {
+    const B = bounds(r)
+    const spots = [[B.x0 + 0.3, B.z0 + 0.3], [B.x1 - 0.3, B.z0 + 0.3], [B.x0 + 0.3, B.z1 - 0.3], [B.x1 - 0.3, B.z1 - 0.3]]
+    torches.forEach((t, i) => {
+      t.visible = true
+      t.position.set(spots[i][0], ROOM_H, spots[i][1])
+    })
+  }
