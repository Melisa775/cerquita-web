+    for (const r of rooms) {
+      if (r.visited) ensureRoom(r, 'visited')
+      else if (near.has(r.id)) ensureRoom(r, 'near')
+    }
+    for (const r of rooms) if (r.visited) r.exits.forEach((e) => ensureCorridor(r.id, e, rooms))
+  }
